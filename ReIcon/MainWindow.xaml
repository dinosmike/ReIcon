<!-- Ширина окна — Width; высота в MainWindow ctor: Width + 48 (квадрат MainContentGrid) -->
<Window x:Class="ReIcon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource Loc_Common_AppTitle}"
        Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Focusable="True"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        Loaded="Window_OnLoaded"
        SizeChanged="Window_OnSizeChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Rs.Window.Background}"
            BorderBrush="{DynamicResource Rs.Border}"
            BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Height="52"
                    Background="{DynamicResource Rs.Surface}"
                    BorderBrush="{DynamicResource Rs.Border}"
                    BorderThickness="0,0,0,1"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="Transparent"
                            Padding="16,0,8,0"
                            MouseLeftButtonDown="TitleBar_OnMouseDown">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="ReIcon"
                                           VerticalAlignment="Center"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Cursor="Hand"
                                           MouseLeftButtonDown="TitleBarAbout_OnMouseLeftButtonDown"/>
                                <Button Click="TitleBarAbout_OnClick"
                                        Style="{StaticResource Rs.TitleBar.AboutInfo}"/>
                            </StackPanel>
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource Rs.Text.Muted}"
                                       Text="{DynamicResource Loc_MainWindow_Subtitle}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="TitleBarLangButton"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            MinHeight="36"
                            Padding="12,6"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="TitleBarLanguage_OnClick"
                            Style="{StaticResource Rs.Button}"
                            ToolTip="{DynamicResource Loc_MainWindow_LanguageTooltip}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Click="LanguageMenuItem_OnClick"
                                          Header="Русский"
                                          Tag="ru"/>
                                <MenuItem Click="LanguageMenuItem_OnClick"
                                          Header="English"
                                          Tag="en"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Click="TitleBarMinimize_OnClick"
                                ToolTip="{DynamicResource Loc_MainWindow_TooltipMinimize}"
                                Style="{StaticResource Rs.TitleBar.Button}"
                                Content="&#x2212;"/>
                        <Button Click="TitleBarClose_OnClick"
                                ToolTip="{DynamicResource Loc_MainWindow_TooltipClose}"
                                Style="{StaticResource Rs.TitleBar.Close}"
                                Content="&#x00D7;"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="MainContentGrid"
                  Margin="20,16,20,20">
                <Border x:Name="DropZoneBorder"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Rs.Surface}"
                        BorderThickness="0"
                        CornerRadius="20"
                        Padding="24"
                        AllowDrop="True"
                        Cursor="Hand"
                        PreviewDragOver="DropZone_OnPreviewDragOver"
                        Drop="DropZone_OnDrop"
                        DragLeave="DropZone_OnDragLeave"
                        MouseEnter="DropZone_OnMouseEnter"
                        MouseLeave="DropZone_OnMouseLeave"
                        MouseLeftButtonUp="DropZone_OnMouseLeftButtonUp">
                    <Grid>
                        <Rectangle x:Name="DropZoneStroke"
                                   RadiusX="20"
                                   RadiusY="20"
                                   Fill="Transparent"
                                   Stroke="{DynamicResource Rs.Border}"
                                   StrokeThickness="2"
                                   StrokeDashArray="5 4"
                                   StrokeDashCap="Flat"
                                   SnapsToDevicePixels="True"
                                   IsHitTestVisible="False"
                                   Margin="-24,-24,-24,-24"/>
                        <StackPanel Orientation="Vertical"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.RenderTransform>
                                <TranslateTransform Y="30"/>
                            </StackPanel.RenderTransform>
                            <Image Width="180"
                                   Height="180"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   Source="pack://application:,,,/drop-image-here.png"/>
                            <TextBlock x:Name="DropPasteHintText"
                                       Margin="0,10,0,0"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="Thin"
                                       Text="{DynamicResource Loc_MainWindow_DropPasteHint}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
